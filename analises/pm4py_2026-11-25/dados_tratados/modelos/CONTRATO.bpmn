<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="defs_v05_CONTRATO" targetNamespace="https://tre-to.tese/modelos/v05">
  <bpmn:process id="Process_v05_CONTRATO" name="Referência documental CONTRATO" isExecutable="false">
